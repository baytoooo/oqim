---
import Base from "../layouts/Base.astro";
import SecHead from "../components/SecHead.astro";
import SignalHead from "../components/SignalHead.astro";
import { EVENT_NAME, PRODUCT } from "../config";
import { bestMode, f, loadAudits, mmss, modeOf, vehiclesOf, weakCheck } from "../lib/audits";

const { source, clips } = loadAudits();
const first = clips[0];
const firstVehicles = first ? vehiclesOf(first) : 0;

// numbers from the sample audits (public/data/audits.json)
const footageMin = clips.reduce((s, c) => s + c.duration, 0) / 60;
const vehicles = clips.reduce((s, c) => s + vehiclesOf(c), 0);
const cycles = clips.map((c) => c.cycle).filter((x): x is number => x !== null);
const cycleRange = cycles.length ? `${Math.round(Math.min(...cycles))} to ${Math.round(Math.max(...cycles))}` : "-";
const maxDelay = Math.max(1, ...clips.flatMap((c) => c.modes.map((m) => m.meanDelay)));

const websterWorse = clips.filter((c) => (modeOf(c, "webster")?.meanDelay ?? 0) > (modeOf(c, "measured")?.meanDelay ?? Infinity));
const websterCycles = clips.map((c) => modeOf(c, "webster")?.cycle).filter((x): x is number => typeof x === "number");
const predictiveWorse = clips.filter((c) => (modeOf(c, "predictive")?.meanDelay ?? 0) > (modeOf(c, "measured")?.meanDelay ?? Infinity));
const predictiveBetter = clips.filter((c) => (modeOf(c, "predictive")?.meanDelay ?? Infinity) < (modeOf(c, "measured")?.meanDelay ?? 0));
const list = (xs: string[]) => (xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs[xs.length - 1]}`);

// the setup of the sample junction, in the 960 x 540 still (the stop line of samples_src/make_audits.ts
// and the vehicle head of public/pipeline/scene.json, both in 1920 px, halved)
const LINE = [[142.5, 263.5], [465, 228.5]];
const HEAD = { x: 567, y: 175, w: 23, h: 40 };

const steps = [
  { n: "01", t: "Mark the junction", d: "On the first frame, draw a stop line across each approach and click its signal head." },
  { n: "02", t: "Detect and track", d: "YOLO26s in ONNX Runtime Web, on WebGPU or WebAssembly, then ByteTrack, at 5 frames per second. All on your device; the video never leaves it." },
  { n: "03", t: "Measure", d: "The lights from the head's pixels, or from when the queue moves off if no head is in view. Crossings, waits, discharge rate, red-light runs." },
  { n: "04", t: "Check the model", d: "A point-queue model replays the clip's own vehicles. It has to give back the measured crossings first." },
  { n: "05", t: "Compare plans", d: "Now, the Webster (1958) formula, a tuned fixed plan searched on the replay, actuated, and OQIM predictive." },
];

const problems = [
  { k: "Set once", t: "Timing is checked by hand", d: "In most cities a signal's timing is set once and checked by hand. A manual junction study means people at the roadside counting cars and timing the lights." },
  { k: "Offline", t: "The controllers cannot be read", d: "Most controllers in the city are not connected, so the timing they run cannot be read from them. Someone has to go to the junction and look." },
  { k: "ATSPM", t: "Measured elsewhere from logs", d: "US cities measure signal performance, such as arrivals on green and split failures, from controller logs with a system called ATSPM. OQIM measures the same things from video, with no access to the controller." },
];

const assumptions = [
  { k: "Price", d: "An audit is sold per junction and priced below a manual study of the same junction. We have no price yet; it is the first thing to test with a buyer." },
  { k: "Field time", d: "Filming an approach takes at least 2 signal cycles, about 3 minutes of video, plus the trip to the junction." },
  { k: "Processing", d: "About 1 minute of processing per minute of 1080p video on an Apple M5 laptop with WebGPU. Phones are slower." },
  { k: "Inference", d: "Zero per camera. The model runs on the user's device, so there is no server bill per video." },
];
---
<Base title={PRODUCT} description="Open a video of a signalised junction. In your browser, OQIM reads the signal lights, counts the vehicles over the stop lines, measures queues and discharge, and checks new signal plans on a replay of the junction's own vehicles." active="home">
  <script is:inline>
    // the start sequence plays once per session
    try { var d = document.documentElement, s = sessionStorage; if (s.getItem("pv-intro")) d.classList.add("no-intro"); s.setItem("pv-intro", "1"); } catch (e) {}
  </script>

  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-text">
      <p class="kicker has-lamp">
        <SignalHead orient="h" size={10} phase="green" run />
        <span>{EVENT_NAME}</span>
      </p>
      <h1 id="hero-title">{PRODUCT}</h1>
      <p class="hero-line">A traffic signal audit from <span class="mark">one video.</span></p>
      <p class="lede">
        Open a video of a signalised junction. In your browser, OQIM reads the signal lights from the pixels, counts every vehicle over the stop lines, measures queues and discharge, and checks new signal plans by replaying the junction's own vehicles.
      </p>
      <div class="hero-cta">
        <a class="btn primary go" href="/audit">Run an audit</a>
        <a class="btn" href="/method">How it works</a>
      </div>
    </div>

    <figure class="hero-fig">
      <div class="cam viewfinder hero-cam">
        <img src="/media/background_960.jpg" alt="The sample junction from the camera, with the southbound stop line drawn across the lanes and a box around the vehicle signal head." width="960" height="540" loading="eager" decoding="async" fetchpriority="high" />
        <svg class="setup" viewBox="0 0 960 540" aria-hidden="true">
          <line class="s-line-shadow" x1={LINE[0][0]} y1={LINE[0][1]} x2={LINE[1][0]} y2={LINE[1][1]} />
          <line class="s-line" x1={LINE[0][0]} y1={LINE[0][1]} x2={LINE[1][0]} y2={LINE[1][1]} />
          <circle class="s-end" cx={LINE[0][0]} cy={LINE[0][1]} r="6" />
          <circle class="s-end" cx={LINE[1][0]} cy={LINE[1][1]} r="6" />
          <rect class="s-head" x={HEAD.x} y={HEAD.y} width={HEAD.w} height={HEAD.h} rx="2" />
          <g class="s-tag" transform={`translate(${LINE[1][0] - 236} ${LINE[1][1] - 58})`}>
            <rect width="222" height="34" rx="3" /><text x="12" y="23">stop line, southbound</text>
          </g>
          <g class="s-tag" transform={`translate(${HEAD.x + HEAD.w + 10} ${HEAD.y + 3})`}>
            <rect width="134" height="34" rx="3" /><text x="12" y="23">signal head</text>
          </g>
        </svg>
        {first && (
          <div class="cam-hud" aria-hidden="true">
            <span>{first.clip}</span>
            {first.cycle !== null && <span>cycle {f(first.cycle, 0)} s</span>}
            <span>{firstVehicles} vehicles southbound</span>
          </div>
        )}
      </div>
      <figcaption class="hero-cap">The sample junction (a background frame of the organisers' footage) with the setup OQIM asks for: a stop line across the approach and a click on its signal head.</figcaption>
    </figure>
  </section>

  <section class="section wrap" id="problem">
    <SecHead num="01 The problem" title="Signal timing is set once and checked by hand">
      <p>A junction cannot be retimed well without measuring it first. Today that measuring is done by people at the roadside.</p>
    </SecHead>
    <ul class="problems" role="list">
      {problems.map((p, i) => (
        <li class="plate" data-reveal style={`--i:${i}`}>
          <span class="pr-k">{p.k}</span>
          <h3 class="plate-title">{p.t}</h3>
          <p class="plate-text">{p.d}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section wrap" id="how">
    <SecHead num="02 How it works" title="Five steps, all in the browser">
      <p>OQIM predictive decides each second whether to end the green or hold it, from the next 30 s of arrivals. In the field those arrivals would come from the camera at the junction upstream; on one clip they come from the clip itself.</p>
    </SecHead>
    <ol class="route route-drive" role="list" data-reveal>
      {steps.map((s) => (
        <li>
          <span class="route-n" aria-hidden="true">{s.n}</span>
          <span class="route-t">{s.t}</span>
          <span class="route-d">{s.d}</span>
        </li>
      ))}
    </ol>
    <p class="how-more"><a class="more" href="/method">The formulas, the checks and where it fails</a></p>
  </section>

  {clips.length > 0 && (
    <section class="section wrap" id="numbers">
      <SecHead num="03 Sample clips" title="What the audit found on our sample clips">
        <p>Mean delay is the mean number of seconds a vehicle waits at the line in the replay. Lower is better. Each plan is run on the same vehicles, so the numbers compare plans on one clip, not clips with each other.</p>
        <p class="src"><span class="src-k">Source</span> {source}.</p>
      </SecHead>

      <div class="stats compact" role="group" aria-label="The sample clips in numbers" data-reveal>
        <div class="stat"><span class="v">{clips.length}</span><span class="k">Clips</span><span class="s">one Tashkent junction</span></div>
        <div class="stat"><span class="v">{footageMin.toFixed(1)}<small>min</small></span><span class="k">Footage</span><span class="s">in total</span></div>
        <div class="stat"><span class="v">{vehicles}</span><span class="k">Vehicles over the stop line</span><span class="s">southbound, all clips</span></div>
        <div class="stat"><span class="v">{cycleRange}<small>s</small></span><span class="k">Cycle</span><span class="s">measured from the lights</span></div>
      </div>

      <ul class="clips" role="list">
        {clips.map((c, i) => {
          const best = bestMode(c);
          return (
            <li class="panel clip" data-reveal style={`--i:${i}`}>
              <div class="clip-top">
                <h3 class="clip-id">{c.clip}</h3>
                <p class="clip-meta mono">
                  <span>{mmss(c.duration)} long</span>
                  <span>cycle {f(c.cycle, 0)} s</span>
                  <span>{vehiclesOf(c)} vehicles</span>
                </p>
              </div>
              <p class="clip-check">
                <span class="ck-k">Model check</span>
                departures off by a median <b class="mono">{f(c.check.departureError, 2)} s</b>; wait in the model <b class="mono">{f(c.check.modelWait)} s</b>, measured <b class="mono">{f(c.check.measuredWait)} s</b>
              </p>
              <ol class="bars" role="list" aria-label={`Mean delay per plan on ${c.clip}`}>
                {c.modes.map((m) => (
                  <li class:list={["bar", { best: m.key === best.key, now: m.key === "measured" }]}>
                    <span class="b-l">{m.label}</span>
                    <span class="b-track" aria-hidden="true"><i style={`width:${((m.meanDelay / maxDelay) * 100).toFixed(1)}%`}></i></span>
                    <span class="b-v mono">{f(m.meanDelay)} s</span>
                  </li>
                ))}
              </ol>
              {weakCheck(c) && (
                <p class="callout warn clip-warn">
                  This clip is {mmss(c.duration)} long, under the 3 minutes OQIM asks for, and the replay misses its departures by a median {f(c.check.departureError, 1)} s. Its plan numbers are shown, not trusted.
                </p>
              )}
            </li>
          );
        })}
      </ul>

      <div class="findings">
        {websterWorse.length > 0 && (
          <div class="callout zebra" data-reveal>
            <p class="callout-k">The textbook plan lost</p>
            <p>
              The Webster formula gave more delay than the current timing on {websterWorse.length === clips.length ? `all ${clips.length}` : `${websterWorse.length} of ${clips.length}`} clips.
              {websterCycles.length > 0 && ` Its cycles came out at ${Math.round(Math.min(...websterCycles))} to ${Math.round(Math.max(...websterCycles))} s, against ${cycleRange} s on the street.`}
              {" "}That is why OQIM checks every plan on the replay before it recommends one.
            </p>
          </div>
        )}
        <div class="callout" data-reveal>
          <p class="callout-k">{predictiveWorse.length > 0 ? "Predictive is not always better" : "Predictive, with one caveat"}</p>
          <p>
            OQIM predictive gave less delay than now on {predictiveBetter.length} of {clips.length} clips{predictiveWorse.length > 0 && `, and more on ${list(predictiveWorse.map((c) => c.clip))}`}.
            It also assumes the arrivals of the next 30 s are known, which needs a second camera upstream.
          </p>
        </div>
      </div>
    </section>
  )}

  <section class="section wrap" id="pays">
    <SecHead num="04 Who pays" title="Sold per junction audit, run on the buyer's own device">
      <p>Every number in this section is an assumption. None has been checked with a buyer yet.</p>
    </SecHead>
    <div class="pays">
      <ul class="buyers" role="list">
        <li class="plate" data-reveal>
          <span class="pr-k">Buyer</span>
          <h3 class="plate-title">The city's traffic management service</h3>
          <p class="plate-text">It owns the signals and decides their timing. OQIM gives it a measured audit of a junction without connecting to the controller.</p>
        </li>
        <li class="plate" data-reveal style="--i:1">
          <span class="pr-k">Buyer</span>
          <h3 class="plate-title">Contractors that run junction studies</h3>
          <p class="plate-text">The firms that now do manual counts and timing studies. With OQIM, the counting at the roadside becomes a few minutes of filming.</p>
        </li>
      </ul>
      <div class="table-scroll cards-sm assume" data-reveal>
        <table>
          <thead><tr><th scope="col">What</th><th scope="col">Assumption</th></tr></thead>
          <tbody>
            {assumptions.map((a) => (
              <tr>
                <th scope="row">{a.k} <span class="chip todo">assumption</span></th>
                <td class="wide-sm">{a.d}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section wrap" id="start">
    <a class="plate zebra cta" href="/audit" data-reveal>
      <span class="plate-title">Run an audit</span>
      <span class="plate-text">Open a video of a signalised junction, or start from a sample clip. The video stays on your device.</span>
      <span class="cta-chev" aria-hidden="true"></span>
    </a>
  </section>
</Base>

<style>
  /* ---------------------------------------------------------- hero */
  .hero {
    display: grid; gap: 28px; align-items: center;
    padding-block: clamp(28px, 5vw, 64px) clamp(32px, 5vw, 64px);
  }
  @media (min-width: 1000px) {
    .hero { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(40px, 4vw, 64px); }
  }
  .hero > * { min-width: 0; }
  .hero h1 {
    margin: 0;
    font-size: clamp(4.5rem, 2rem + 9vw, 8.5rem); line-height: .85; letter-spacing: .01em;
  }
  .hero-line {
    margin: 10px 0 22px;
    font: 600 clamp(1.75rem, 1.2rem + 1.8vw, 2.5rem)/1.05 var(--font-display); font-synthesis: none; color: var(--paint);
    text-wrap: balance;
  }
  .mark { background: linear-gradient(var(--zebra), var(--zebra)) 0 94% / 100% .1em no-repeat; }
  .hero .lede { margin: 0; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }

  .hero-cam { aspect-ratio: 16 / 9; }
  .hero-cam > img { position: absolute; inset: 0; }
  .setup { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; }
  .s-line-shadow { stroke: rgba(0, 0, 0, .55); stroke-width: 9; stroke-linecap: round; }
  .s-line { stroke: var(--zebra); stroke-width: 5; stroke-linecap: round; }
  .s-end { fill: var(--ink); stroke: var(--zebra); stroke-width: 3; }
  .s-head { fill: none; stroke: var(--zebra); stroke-width: 2.5; stroke-dasharray: 5 3; }
  .s-tag rect { fill: rgba(13, 14, 16, .86); stroke: var(--line-2); }
  .s-tag text { font: 600 18px var(--font-mono); fill: var(--paint); }
  .hero-cap { margin: 10px 0 0; font-size: .875rem; line-height: 1.5; color: var(--muted); max-width: 70ch; }
  @media (prefers-reduced-motion: no-preference) {
    .s-line { stroke-dasharray: 340; stroke-dashoffset: 340; animation: draw 900ms var(--ease-out) 500ms forwards; }
    .s-head, .s-tag { animation: fade 400ms ease-out 1200ms backwards; }
    :global(.no-intro) .s-line { animation: none; stroke-dashoffset: 0; }
    :global(.no-intro) .s-head, :global(.no-intro) .s-tag { animation: none; }
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { from { opacity: 0; } }

  /* ---------------------------------------------------------- problem */
  .problems, .buyers, .clips { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .problems > *, .buyers > *, .clips > * { min-width: 0; }
  @media (min-width: 860px) { .problems { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .pr-k { font: 600 .75rem/1.3 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--zebra); }

  /* ---------------------------------------------------------- how */
  .how-more { margin: 28px 0 0; }

  /* ---------------------------------------------------------- numbers */
  .src { font-size: .875rem; color: var(--muted); }
  .src-k { font: 600 .75rem/1.3 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--paint-2); margin-right: 6px; }
  .clips { margin-top: 16px; }
  @media (min-width: 900px) { .clips { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .clip { padding: 18px 20px 20px; display: grid; gap: 14px; align-content: start; }
  .clip-top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 16px; }
  .clip-id { margin: 0; font-size: 1.75rem; }
  .clip-meta { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: .8125rem; color: var(--paint-2); }
  .clip-check { margin: 0; font-size: .9375rem; line-height: 1.5; color: var(--paint-2); }
  .clip-check b { color: var(--paint); font-weight: 600; }
  .ck-k { display: block; font: 600 .75rem/1.3 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 2px; }
  .bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .bar { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr) 4rem; gap: 10px; align-items: center; font-size: .875rem; }
  .b-l { color: var(--paint-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .b-track { height: 12px; background: var(--asphalt-0); border-radius: var(--r-1); overflow: hidden; }
  .b-track i { display: block; height: 100%; background: var(--line-2); border-radius: var(--r-1); }
  .b-v { text-align: right; color: var(--paint-2); font-size: .8125rem; }
  .bar.now .b-track i { background: var(--paint-2); }
  .bar.now .b-l { color: var(--paint); }
  .bar.best .b-track i { background: var(--zebra); }
  .bar.best .b-v, .bar.best .b-l { color: var(--zebra); font-weight: 700; }
  @media (max-width: 420px) { .bar { grid-template-columns: 7.5rem minmax(0, 1fr) 3.5rem; gap: 8px; } }
  .clip-warn { margin: 0; }
  .findings { display: grid; gap: 14px; margin-top: 20px; }
  @media (min-width: 900px) { .findings { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; } }
  .findings > * { min-width: 0; max-width: none; }

  /* ---------------------------------------------------------- who pays */
  .pays { display: grid; gap: 14px; }
  @media (min-width: 1000px) { .pays { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; } }
  .pays > * { min-width: 0; }
  .assume th[scope="row"] { white-space: nowrap; font-weight: 700; color: var(--paint); }
  .assume th[scope="row"] .chip { margin-left: 6px; vertical-align: 1px; }
  .assume td { color: var(--paint-2); }
  @media (max-width: 640px) { .assume th[scope="row"] { white-space: normal; } }

  /* ---------------------------------------------------------- final call */
  .cta { min-height: 180px; padding: 36px 24px 28px; gap: 10px; }
  .cta::before {
    content: ""; position: absolute; top: 6px; left: 6px; right: 6px; height: 10px;
    background: var(--hazard); border-radius: 3px 3px 0 0;
  }
  .cta .plate-title { font: 700 clamp(2.25rem, 1.6rem + 2vw, 3.25rem)/1 var(--font-display); margin-top: 8px; }
  .cta .plate-text { max-width: 52ch; padding-right: 72px; font-size: 1.0625rem; }
  .cta-chev {
    position: absolute; right: 24px; bottom: 24px; width: 52px; height: 52px;
    background: currentColor; -webkit-mask: var(--chev) center / contain no-repeat; mask: var(--chev) center / contain no-repeat;
    transition: transform var(--t-2) var(--ease-out);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cta:hover .cta-chev, .cta:focus-visible .cta-chev { transform: translateX(4px); }
  }
</style>
